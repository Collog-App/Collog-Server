API_DOMAIN=
LIVEKIT_DOMAIN=
ACME_EMAIL=

# Generate independent hexadecimal values with openssl rand -hex 32.
DB_PASSWORD=
JWT_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_INSTANCE_ROLE=false
S3_BUCKET=
S3_REGION=ap-northeast-2

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
APPLE_LOGIN_ENABLED=true
APPLE_CLIENT_ID=com.dohyeoplim.collog-ios
APPLE_TEAM_ID=3X4434LYHD
APPLE_KEY_ID=
APPLE_KEY_FILE=
# Google web client ID for Android sign-in. Empty uses the Collog Firebase web client.
GOOGLE_CLIENT_ID=
# Kakao native app key (the ID token audience). Empty disables Kakao login.
KAKAO_APP_KEY=
# Absolute host path to the Firebase service account JSON. Empty disables Android push.
FCM_KEY_FILE=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
GEMINI_DATA_PROCESSING_APPROVED=false
ELEVENLABS_DATA_PROCESSING_APPROVED=false

# Absolute host path. The container reads /run/secrets/apns.p8.
APNS_KEY_FILE=
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=3X4434LYHD
APNS_KEY_ID=
APNS_BUNDLE_ID=com.dohyeoplim.collog-ios

QUESTION_TTS_PROVIDER=ios_local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Subscription billing (RevenueCat). Empty BILLING_LAUNCH_AT keeps billing off: everyone is premium,
# nothing is locked and there is no analysis limit. Set it (ISO time with offset, e.g.
# 2026-12-15T00:00:00+09:00) only after the app with the paywall is live on both stores.
BILLING_LAUNCH_AT=
# Server secret key (sk_...) for GET /v1/subscribers. Never ship it in the apps.
REVENUECAT_SECRET_KEY=
# The exact Authorization header value set on the RevenueCat webhook. Empty answers 503.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium
# Sandbox purchases (TestFlight, license testers) count when true.
# App Store 심사·TestFlight 구매는 샌드박스라 true 로 둔다.
REVENUECAT_ALLOW_SANDBOX=true
TRIAL_DAYS=14
FREE_ANALYSIS_SECONDS=2400
PREMIUM_ANALYSIS_SECONDS=15000
